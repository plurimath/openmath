{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "id",
    "files",
    "bindings",
    "hooks"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "openmath-extension/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "file",
          "constant"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "const": "installer"
          },
          "file": {
            "type": "string"
          },
          "constant": {
            "type": "string",
            "pattern": "^[A-Z][A-Za-z0-9_]*(::[A-Z][A-Za-z0-9_]*)*$"
          }
        }
      }
    }
  }
}
